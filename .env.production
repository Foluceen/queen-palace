# Production build configuration (committed on purpose: these are public, non-secret values).
# Values set in the Vercel dashboard override this file. Never put secrets in NEXT_PUBLIC_ variables.

# Live mode: the storefront and admin talk only to the real API. There is no fallback to mock data.
NEXT_PUBLIC_DATA_MODE=live

# The API serves every contract route under /v1, so the base URL includes it.
# PENDING HERMES CONFIRMATION. As of 29 Oct 2026 this old host no longer reaches the backend, and
# api.queenluxuryhair.store answers instead (observed, not yet confirmed by the backend).
# Switch to https://api.queenluxuryhair.store/v1 here and in Vercel once Hermes confirms the
# endpoint, DNS, TLS, CORS and cookie settings. See docs/LIVE_READINESS.md, "Domain change".
NEXT_PUBLIC_API_BASE_URL=https://api.queenpalacebeauty.store/v1

# Canonical storefront origin. Used for metadata, canonical links and structured data.
NEXT_PUBLIC_SITE_URL=https://queenluxuryhair.store

# Seconds API responses stay in Next's data cache for server-rendered pages.
CATALOG_REVALIDATE_SECONDS=60
