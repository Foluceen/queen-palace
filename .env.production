# Production build configuration (committed on purpose: these are public, non-secret values).
# Values set in the Vercel dashboard override this file. Never put secrets in NEXT_PUBLIC_ variables.

# Live mode: the storefront and admin talk only to the real API. There is no fallback to mock data.
# Local development stays on mock data (npm run dev reads .env.development / defaults, not this file).
NEXT_PUBLIC_DATA_MODE=live

# Production API (confirmed by the backend, 29 Oct 2026). Every contract route is under /v1.
NEXT_PUBLIC_API_BASE_URL=https://api.queenluxuryhair.store/v1
# Server-side calls (same API; set separately so it can point at a private address later).
API_BASE_URL=https://api.queenluxuryhair.store/v1

# Canonical storefront origin (Vercel serves www and redirects the apex to it). Used for metadata, canonical links, structured data and robots.
NEXT_PUBLIC_SITE_URL=https://www.queenluxuryhair.store

# Seconds API responses stay in Next's data cache for server-rendered pages.
CATALOG_REVALIDATE_SECONDS=60
