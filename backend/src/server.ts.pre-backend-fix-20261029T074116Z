app.put('/v1/admin/collections/:id',async(req:any,reply)=>{if(!await requireSession(req,reply,'admin'))return;const b=collectionBody.safeParse(req.body);if(!b.success)return err(reply,400,'validation_error','Invalid collection');const d=b.data;const c=await pool.query('UPDATE collections SET handle=$1,title=$2,summary=$3,description=$4,status=COALESCE($5,status),position=COALESCE($6,position),seo=COALESCE($7,seo),updated_at=now() WHERE id=$8 RETURNING *',[d.handle,d.title,d.summary||'',d.description||'',d.status,d.position,d.seo?JSON.stringify(d.seo):null,req.params.id]);if(!c.rowCount)return err(reply,404,'not_found','Collection not found');if(d.productIds){await pool.query('DELETE FROM product_collections WHERE collection_id=$1',[req.params.id]);for(let i=0;i<d.productIds.length;i++)await pool.query('INSERT INTO product_collections(product_id,collection_id,position) VALUES($1,$2,$3)',[d.productIds[i],req.params.id,i]);}return {...c.rows[0],productCount:d.productIds?.length||0,image:null,banner:null,updatedAt:c.rows[0].updated_at};});
