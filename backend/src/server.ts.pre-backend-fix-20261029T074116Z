async function login(req:any,reply:any,kind:'admin'|'customer'){const s=z.object({email:z.string().email(),password:z.string().min(8)}).safeParse(req.body);if(!s.success)return err(reply,400,'validation_error','Invalid credentials');const table=kind==='admin'?'staff':'customers';const r=await pool.query(`SELECT * FROM ${table} WHERE email=$1 AND ${kind==='admin'?"status='active'":"true"}`,[s.data.email.toLowerCase()]);if(!r.rowCount||!(await argon2.verify(r.rows[0].password_hash,s.data.password)))return err(reply,401,'invalid_credentials','Invalid credentials');const raw=token();await pool.query('INSERT INTO sessions(id,subject_id,kind,expires_at) VALUES($1,$2,$3,now()+interval \'7 days\')',[raw,r.rows[0].id,kind]);reply.setCookie(kind==='admin'?'qp_admin':'qp_customer',raw,{httpOnly:true,secure:process.env.NODE_ENV==='production',sameSite:'lax',path:'/',maxAge:604800});return kind==='admin'?adminSessionView(r.rows[0]):{customer:{id:r.rows[0].id,name:r.rows[0].name,email:r.rows[0].email}};}
