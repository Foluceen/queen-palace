function err(reply:any, status:number, code:string, message:string, fields?:unknown){ return reply.code(status).send({error:{code,message, ...(fields?{fields}: {})}}); }
async function session(req:any, kind:'customer'|'admin'){ const raw=req.cookies[kind==='admin'?'qp_admin':'qp_customer']; if(!raw) return null; const r=await pool.query('SELECT * FROM sessions WHERE id=$1 AND kind=$2 AND expires_at>now()',[raw,kind]); return r.rows[0]||null; }
async function requireSession(req:any, reply:any, kind:'customer'|'admin'){ const s=await session(req,kind); if(!s) { err(reply,401,'unauthorized','Authentication required'); return null; } return s; }
