app.post('/v1/checkout',async(req:any,reply)=>{const s=z.object({cartId:z.string().uuid(),contact:z.object({email:z.string().email(),phone:z.string().min(1),marketingOptIn:z.boolean()}),shippingAddress:z.record(z.any()),shippingRateId:z.string(),paymentMethod:z.enum(['paystack','flutterwave','bank_transfer','pay_on_delivery']),note:z.string().max(1000).optional(),idempotencyKey:z.string().min(8).max(200)}).safeParse(req.body);if(!s.success)return err(reply,400,'validation_error','Invalid checkout');const client=await pool.connect();try{await client.query('BEGIN');const prior=await client.query('SELECT o.* FROM idempotency_keys k JOIN orders o ON o.id=k.order_id WHERE k.key=$1',[s.data.idempotencyKey]);if(prior.rowCount){await client.query('COMMIT');return {order:{id:prior.rows[0].id,number:prior.rows[0].number},payment:{provider:s.data.paymentMethod,status:'pending',reference:prior.rows[0].number,redirectUrl:null,bankTransfer:null}};}const lines=await client.query('SELECT l.*,p.title,p.price_kobo,p.stock FROM cart_lines l JOIN products p ON p.id=l.product_id WHERE l.cart_id=$1 FOR UPDATE',[s.data.cartId]);if(!lines.rowCount)return err(reply,400,'empty_cart','Cart is empty');let subtotal=0;for(const l of lines.rows){if(l.quantity>l.stock){await client.query('ROLLBACK');return err(reply,409,'out_of_stock','Insufficient stock for '+l.title);}subtotal+=Number(l.price_kobo)*l.quantity;}const shipping=0,total=subtotal;const number='QLH-'+Date.now().toString(36).toUpperCase()+'-'+crypto.randomBytes(3).toString('hex').toUpperCase();const access=token();const customer=(await session(req,'customer'));const o=await client.query('INSERT INTO orders(number,email,customer_id,subtotal_kobo,shipping_kobo,total_kobo,access_token_hash) VALUES($1,$2,$3,$4,$5,$6,$7) RETURNING *',[number,s.data.contact.email.toLowerCase(),customer?.subject_id||null,subtotal,shipping,total,hash(access)]);for(const l of lines.rows){await client.query('INSERT INTO order_lines(order_id,product_id,title,quantity,unit_price_kobo) VALUES($1,$2,$3,$4,$5)',[o.rows[0].id,l.product_id,l.title,l.quantity,l.price_kobo]);await client.query('UPDATE products SET stock=stock-$1,updated_at=now() WHERE id=$2',[l.quantity,l.product_id]);}await client.query('INSERT INTO idempotency_keys(key,order_id) VALUES($1,$2)',[s.data.idempotencyKey,o.rows[0].id]);await client.query('DELETE FROM cart_lines WHERE cart_id=$1',[s.data.cartId]);await client.query('COMMIT');return reply.code(201).send({order:{id:o.rows[0].id,number,accessToken:access,status:'open',paymentStatus:'pending',fulfillmentStatus:'unfulfilled',paymentMethod:s.data.paymentMethod,email:s.data.contact.email,totals:{subtotal,discountTotal:0,shippingTotal:shipping,total,currency:'NGN'},itemCount:lines.rows.length,createdAt:o.rows[0].created_at},payment:{provider:s.data.paymentMethod,status:'pending',reference:number,redirectUrl:null,bankTransfer:null}});}catch(e){await client.query('ROLLBACK');throw e;}finally{client.release();}});
