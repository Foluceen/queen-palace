app.get('/v1/products', async(req:any)=>{const q=req.query as any; const vals:any[]=[]; let where="p.status='published'"; if(q.q){vals.push('%'+q.q+'%');where+=' AND (p.title ILIKE $'+vals.length+' OR p.description ILIKE $'+vals.length+')';} const r=await pool.query('SELECT p.* FROM products p WHERE '+where+' ORDER BY p.featured DESC,p.created_at DESC',vals); const items=r.rows.map(product); return {items,page:1,pageSize:items.length,total:items.length,totalPages:1,facets:[],priceBounds:{min:items.length?Math.min(...items.map(x=>x.priceRange.min)):0,max:items.length?Math.max(...items.map(x=>x.priceRange.max)):0}};});
