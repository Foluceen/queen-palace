app.post('/v1/products/:productId/reviews',{config:{rateLimit:{max:5,timeWindow:'1 hour'}}}, async(req:any,reply)=>{const customer=await session(req,'customer');const b=z.object({author:z.string().min(2).max(60),email:z.string().email(),rating:z.number().int().min(1).max(5),title:z.string().max(100).optional(),body:z.string().min(20).max(2000),location:z.string().max(60).optional()}).safeParse(req.body);if(!b.success)return err(reply,422,'validation_failed','Review fields are invalid',b.error.flatten().fieldErrors);const p=await pool.query('SELECT id FROM products WHERE id=$1 AND status=\'published\'',[req.params.productId]);if(!p.rowCount)return err(reply,404,'not_found','Product not found');try{const r=await pool.query('INSERT INTO reviews(product_id,customer_id,author,email,location,rating,title,body) VALUES($1,$2,$3,$4,$5,$6,$7,$8) RETURNING id,status,created_at',[req.params.productId,customer?.subject_id||null,b.data.author.trim(),b.data.email.toLowerCase(),b.data.location?.trim()||null,b.data.rating,b.data.title?.trim()||'',b.data.body.trim()]);return reply.code(201).send({id:r.rows[0].id,status:r.rows[0].status,createdAt:r.rows[0].created_at});}catch(e:any){if(e.code==='23505')return err(reply,409,'review_exists','You have already reviewed this product');throw e;}});
const cartView=async(cartId:string)=>{const c=await pool.query('SELECT id FROM carts WHERE id=$1 AND status=\'open\'',[cartId]);if(!c.rowCount)return null;const l=await pool.query('SELECT l.id line_id,l.product_id,l.quantity,p.handle,p.title,p.price_kobo,p.compare_at_kobo,p.stock,p.status FROM cart_lines l JOIN products p ON p.id=l.product_id WHERE l.cart_id=$1 ORDER BY l.id',[cartId]);const lines=l.rows.map(x=>({id:x.line_id,productId:x.product_id,variantId:x.product_id,handle:x.handle,productTitle:x.title,variantTitle:x.title,image:null,quantity:x.quantity,unitPrice:Number(x.price_kobo),compareAtPrice:x.compare_at_kobo==null?null:Number(x.compare_at_kobo),lineTotal:Number(x.price_kobo)*x.quantity,maxQuantity:Math.max(0,x.stock),availability:x.status!=='published'?'out_of_stock':x.stock<=0?'out_of_stock':x.stock<=5?'low_stock':'in_stock'}));const subtotal=lines.reduce((a,x)=>a+x.lineTotal,0);return {id:c.rows[0].id,currency:'NGN',lines,itemCount:lines.reduce((a,x)=>a+x.quantity,0),discounts:[],totals:{subtotal,discountTotal:0,shippingTotal:null,taxTotal:0,total:subtotal},notices:[],updatedAt:new Date().toISOString()};};app.get('/v1/carts/:cartId',async(req:any,reply)=>{const v=await cartView(req.params.cartId);if(!v)return err(reply,404,'not_found','Cart not found');return v;});
app.post('/v1/carts/:cartId/lines', async(req:any,reply)=>{const s=z.object({lines:z.array(z.object({productId:z.string().uuid().optional(),variantId:z.string().uuid().optional(),quantity:z.number().int().min(1).max(99)}).refine(x=>x.productId||x.variantId)).min(1)}).safeParse(req.body); if(!s.success)return err(reply,400,'validation_error','Invalid cart lines'); const cart=await pool.query('SELECT id FROM carts WHERE id=$1',[req.params.cartId]); if(!cart.rowCount)return err(reply,404,'not_found','Cart not found'); for(const x of s.data.lines){const productId=x.productId||x.variantId; const p=await pool.query('SELECT id,stock FROM products WHERE id=$1 AND status=\'published\'',[productId]);if(!p.rowCount)return err(reply,400,'invalid_product','Product unavailable');if(x.quantity>p.rows[0].stock)return err(reply,409,'out_of_stock','Insufficient stock');await pool.query('INSERT INTO cart_lines(cart_id,product_id,quantity) VALUES($1,$2,$3) ON CONFLICT(cart_id,product_id) DO UPDATE SET quantity=EXCLUDED.quantity',[req.params.cartId,productId,x.quantity]);} const r=await app.inject({method:'GET',url:'/v1/carts/'+req.params.cartId});return reply.send(r.json());});
