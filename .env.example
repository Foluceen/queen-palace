# Data source for the storefront and admin.
#   mock — in-process mock backend (src/lib/mock). Nothing is persisted; no payments are taken.
#   live — the Fastify backend at API_BASE_URL / NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_DATA_MODE=mock

# Optional. Base URL for server-side requests only (e.g. a private network address on the same host).
# When unset, server code uses NEXT_PUBLIC_API_BASE_URL. Production does not need it.
# API_BASE_URL=http://localhost:4000/v1

# Fastify backend base URL used in the browser (cart, checkout, admin), including the /v1 prefix.
# Must be reachable from the customer's device and allow credentialed CORS from SITE_URL.
# Production: https://api.queenpalacebeauty.store/v1 (see .env.production).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Public site URL, used for canonical URLs, metadata and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated hosts allowed for next/image (e.g. your media CDN).
NEXT_PUBLIC_MEDIA_HOSTS=

# Seconds server-rendered catalog pages stay cached before revalidating.
CATALOG_REVALIDATE_SECONDS=60
